#include <WiFiS3.h>
#include <PubSubClient.h>
 
// -------------------------
// 🔧 CONFIGURATION WIFI
// -------------------------
const char* ssid = "GG_TEP";             // ← remplace par ton WiFi
const char* password = "lolaflorez&"; // ← remplace par ton mot de passe
 
// -------------------------
// 🔧 CONFIGURATION MQTT
// -------------------------
const char* mqtt_server = "io.adafruit.com";   // ou ton broker Node-RED local (ex: "192.168.1.50")
const int mqtt_port = 1883;
const char* mqtt_user = "Ethan788";            // ton nom d’utilisateur Adafruit IO
const char* mqtt_key = "aio_OUAy13Q5I6jYUoYnhqEnvwfjyFjq";  // ta clé API Adafruit IO
 
const char* topic_alarme = "Ethan788/feeds/alarme";  // topic MQTT
 
WiFiClient espClient;
PubSubClient client(espClient);
 
// -------------------------
// 🧲 CONFIG CAPTEUR
// -------------------------
const int capteurPin = 12;   // 🟢 Capteur magnétique sur GPIO 12
int dernierEtat = HIGH;      // État précédent (fermé)
 
// -------------------------
// ⚙️ FONCTIONS
// -------------------------
void setup_wifi() {
  delay(10);
  Serial.println();
  Serial.print("Connexion au WiFi ");
  Serial.println(ssid);
 
 
  while (WiFi.begin(ssid, password) != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
 
  Serial.println("");
  Serial.println("✅ WiFi connecté");
  Serial.print("Adresse IP: ");
  Serial.println(WiFi.localIP());
}
 
void reconnect() {
  while (!client.connected()) {
    Serial.print("Connexion au broker MQTT...");
    if (client.connect("ESP32Client", mqtt_user, mqtt_key)) {
      Serial.println("connecté !");
    } else {
      Serial.print("Échec, code erreur = ");
      Serial.print(client.state());
      Serial.println(" ; nouvel essai dans 5s");
      delay(5000);
    }
  }
}
 
// -------------------------
// 🧠 SETUP
// -------------------------
void setup() {
  Serial.begin(115200);
  pinMode(capteurPin, INPUT_PULLUP);  // capteur tiré à LOW quand fermé (contact fermé = 0)
 
  setup_wifi();
  client.setServer(mqtt_server, mqtt_port);
}
 
// -------------------------
// 🔁 BOUCLE PRINCIPALE
// -------------------------
void loop() {
  if (!client.connected()) {
    reconnect();
  }
  client.loop();
 
  int etatCapteur = digitalRead(capteurPin);
 
  // Détection de changement d’état (ouverture = HIGH)
  if (etatCapteur != dernierEtat) {
    if (etatCapteur == HIGH) {
      Serial.println("🚨 Intrusion détectée !");
      client.publish(topic_alarme, "Intrusion!");
    } else {
      Serial.println("🔒 Fenêtre refermée");
    }
    dernierEtat = etatCapteur;
  }
}
