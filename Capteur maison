#include <WiFi.h>
#include <PubSubClient.h>
 
// -------------------------
// 🔧 CONFIGURATION WIFI
// -------------------------
const char* ssid = "GG_TEP";              // Remplace par ton WiFi
const char* password = "lolaflorez&";     // Remplace par ton mot de passe
 
// -------------------------
// 🔧 CONFIGURATION MQTT
// -------------------------
const char* mqtt_server = "io.adafruit.com";    // Serveur MQTT Adafruit IO
const int mqtt_port = 1883;
const char* mqtt_user = "Ethan788";             // Nom d’utilisateur Adafruit IO
const char* mqtt_key = "aio_moZB49LGStva5i3kE4YAieIerkdm";  // Clé API Adafruit IO
 
const char* topic_capteurs = "Ethan788/feeds/capteur";  // Topic MQTT pour tous les capteurs
 
WiFiClient espClient;
PubSubClient client(espClient);
 
// -------------------------
// 🧲 CONFIG CAPTEURS
// -------------------------
const int capteurPin1 = 13;   // Capteur magnétique sur GPIO 13 (Fenêtre 1)
const int capteurPin2 = 12;   // Capteur magnétique sur GPIO 12 (Fenêtre 2)
const int capteurPin3 = 11;   // Capteur magnétique sur GPIO 11 (Porte)
 
int dernierEtat1 = HIGH;  // État précédent pour capteur 1 (Fenêtre 1)
int dernierEtat2 = HIGH;  // État précédent pour capteur 2 (Fenêtre 2)
int dernierEtat3 = HIGH;  // État précédent pour capteur 3 (Porte)
 
// -------------------------
// ⚙️ FONCTIONS
// -------------------------
void setup_wifi() {
  delay(10);
  Serial.println();
  Serial.print("Connexion au WiFi ");
  Serial.println(ssid);
 
  while (WiFi.begin(ssid, password) != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
 
  Serial.println("");
  Serial.println("✅ WiFi connecté");
  Serial.print("Adresse IP: ");
  Serial.println(WiFi.localIP());
}
 
void reconnect() {
  while (!client.connected()) {
    Serial.print("Connexion au broker MQTT...");
    if (client.connect("ESP32Client", mqtt_user, mqtt_key)) {
      Serial.println("connecté !");
    } else {
      Serial.print("Échec, code erreur = ");
      Serial.print(client.state());
      Serial.println(" ; nouvel essai dans 5s");
      delay(10000);
    }
  }
}
 
// -------------------------
// 🧠 SETUP
// -------------------------
void setup() {
  Serial.begin(115200);
  pinMode(capteurPin1, INPUT_PULLUP);  // Capteur 1 (Fenêtre 1)
  pinMode(capteurPin2, INPUT_PULLUP);  // Capteur 2 (Fenêtre 2)
  pinMode(capteurPin3, INPUT_PULLUP);  // Capteur 3 (Porte)
 
  setup_wifi();
  client.setServer(mqtt_server, mqtt_port);
}
 
// -------------------------
// 🔁 BOUCLE PRINCIPALE
// -------------------------
void loop() {
  if (!client.connected()) {
    reconnect();
  }
  client.loop();
 
  int etatCapteur1 = digitalRead(capteurPin1);  // Lire l'état du capteur 1 (Fenêtre 1)
  int etatCapteur2 = digitalRead(capteurPin2);  // Lire l'état du capteur 2 (Fenêtre 2)
  int etatCapteur3 = digitalRead(capteurPin3);  // Lire l'état du capteur 3 (Porte)
 
  // Vérifier si l'état de l'un des capteurs a changé
  if (etatCapteur1 != dernierEtat1) {
    if (etatCapteur1 == HIGH) {
      // Fenêtre 1 ouverte
      client.publish(topic_capteurs, "Fenêtre 1 ouverte");
    } else {
      // Fenêtre 1 fermée
      client.publish(topic_capteurs, "Fenêtre 1 fermée");
    }
    dernierEtat1 = etatCapteur1;
  }
 
  if (etatCapteur2 != dernierEtat2) {
    if (etatCapteur2 == HIGH) {
      // Fenêtre 2 ouverte
      client.publish(topic_capteurs, "Fenêtre 2 ouverte");
    } else {
      // Fenêtre 2 fermée
      client.publish(topic_capteurs, "Fenêtre 2 fermée");
    }
    dernierEtat2 = etatCapteur2;
  }
 
  if (etatCapteur3 != dernierEtat3) {
    if (etatCapteur3 == HIGH) {
      // Porte ouverte
      client.publish(topic_capteurs, "Porte ouverte");
    } else {
      // Porte fermée
      client.publish(topic_capteurs, "Porte fermée");
    }
    dernierEtat3 = etatCapteur3;
  }
 
  delay(2000);  // Attendre 2 secondes avant la prochaine lecture
}
 
 
